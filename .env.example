# Backend secret. Set this in Render's Environment settings, never in Vite/client variables.
GEMINI_API_KEY=

# Backend runtime
NODE_ENV=development
PORT=3000
GEMINI_MODEL=gemini-3.8-flash

# Comma-separated allowed browser origins (origins do not include URL paths).
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://lilsynnofficial.github.io

# Frontend build-time settings. Set VITE_API_BASE_URL to the Render service origin for Pages.
VITE_API_BASE_URL=
VITE_BASE_PATH=/
